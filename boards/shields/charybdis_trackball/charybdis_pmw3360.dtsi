/* Sensor wiring (nice!nano D-pin labels, per PCB GPIO map):
 *   SCLK -> D0 (P0.08)
 *   MISO -> D1 (P0.06)  -- this pad previously carried the PMW3610's MOTION line
 *   MOSI -> D2 (P0.17)  -- this pad previously carried the PMW3610's shared SDIO line
 *   NCS  -> D3 (P0.20)
 * MOTION and RESET are not wired:
 *   - RESET has no GPIO in this driver; the sensor is reset purely over SPI
 *     (NCS toggle + power-up-reset register write), so tie RESET to VDDIO
 *     on the sensor board itself rather than leaving it floating.
 *   - MOTION would need a spare GPIO run to the sensor (D14/D15/D16 are free
 *     on this PCB) - until that's wired, the driver polls over SPI instead.
 */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 6)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3360";
        reg = <0>;
        spi-max-frequency = <2000000>;
        cpi = <600>;

        /* No irq-gpios: MOTION isn't wired yet, so this polls over SPI
           instead of interrupt-driven. Wire MOTION to a spare GPIO
           (D14/D15/D16 are free) and add irq-gpios here to switch to
           interrupt-driven reporting and save battery. */
        polling-interval = <4000>;

        /* Sensor orientation is untested on this hardware - start here,
           then adjust rotate-90/180/270 and invert-x/invert-y once you
           can see which way cursor movement actually goes. */
        // invert-x;
        // invert-y;
        // rotate-90;
    };
};

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled"; // overridden on central
        device = <&trackball_split>;
    };
};
